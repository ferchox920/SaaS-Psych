APP_ENV=local
DEMO_MODE=false
APP_VERSION=development
BUILD_REVISION=unknown
HTTP_PORT=8080
DATABASE_URL=postgres://sessionflow:sessionflow@127.0.0.1:5433/sessionflow?sslmode=disable
REDIS_URL=redis://localhost:6379
# local only; set a unique secret outside local or startup will fail
JWT_ACCESS_SECRET=change-me
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
WEB_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
CLINICAL_AUDIO_ENABLED=false
CLINICAL_RISK_PROTOCOL=Evaluar seguridad, inmediatez, intencion, medios, proteccion y capacidad de autocuidado; documentar el juicio clinico y seguir el circuito local de emergencia definido por la organizacion.
TRANSCRIBER_BASE_URL=http://127.0.0.1:8091
TRANSCRIBER_TIMEOUT_SECONDS=120
TRANSCRIBER_MAX_AUDIO_MB=25
# Google Calendar remains disabled until OAuth credentials and a dedicated
# 32-byte base64 encryption key are configured.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URL=http://127.0.0.1:8080/api/v1/integrations/google-calendar/callback
GOOGLE_CALENDAR_TOKEN_KEY=
GOOGLE_CALENDAR_TIMEOUT_SECONDS=20
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_KEEP_ALIVE=15m
OLLAMA_MAX_OUTPUT_TOKENS=384
OLLAMA_REVIEW_CONTEXT_TOKENS=8192
OLLAMA_REVIEW_TEMPERATURE=0.15
OLLAMA_REVIEW_TIMEOUT_SECONDS=180
OLLAMA_REVIEW_MAX_OUTPUT_TOKENS=1024
OLLAMA_REVIEW_THINK=false
RATE_LIMIT_LOGIN_PER_MIN=10
TRUSTED_PROXY_CIDRS=
OTEL_SERVICE_NAME=sessionflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACES_EXPORTER=none
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
OTEL_DB_STATEMENT_ENABLED=false
# Durable ingestion stays disabled until deployment approves explicit retention.
CLINICAL_INGESTION_ENABLED=false
CLINICAL_ARTIFACT_ROOT=
CLINICAL_ARTIFACT_KEY_ID=
# Supply a unique 32-byte base64 key from a secret manager; never commit it.
CLINICAL_ARTIFACT_KEY=
# No legal/product duration is implied. Must be a positive approved number.
CLINICAL_AUDIO_RETENTION_HOURS=
# Set explicit_deletion only after approving transcript deletion policy.
CLINICAL_TRANSCRIPT_RETENTION_POLICY=
# Set retain_provenance only after approving job/audit metadata policy.
CLINICAL_JOB_METADATA_RETENTION_POLICY=
# Explicit tenant UUID list; provision the same list for all worker replicas.
CLINICAL_INGESTION_WORKER_TENANTS=
CLINICAL_INGESTION_TIMEOUT_SECONDS=600
# Exact hash returned by the local sidecar health endpoint.
CLINICAL_TRANSCRIPTION_CONFIGURATION_HASH=
